# Copy to .env (git-ignored). docker compose and the app both read it.
# Empty optional values keep the feature off; commented lines show the default.

# Database (required)
POSTGRES_DB=pytra_db
POSTGRES_USER=pytra
POSTGRES_PASSWORD=change-me
# The default PGHOST is a LAN address, so keep this for the bundled docker-compose.yml
PGHOST=localhost
#PGPORT=5432

# Auth (required)
# Base64 key of at least 256 bits: openssl rand -base64 32
JWT_SECRET=change-me
# Session lifetime in milliseconds (30 days)
JWT_EXPIRATION=2592000000
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# URLs
#PORT=8080
#FRONTEND_URL=http://localhost:4200
#PUBLIC_API_URL=http://localhost:8080
#CORS_ALLOWED_ORIGINS=http://localhost:4200,https://localhost
#MOBILE_REDIRECT_URI=com.estebanmm13.pytra://oauth-callback

# Email (without BREVO_API_KEY, emails are logged instead of sent)
BREVO_API_KEY=
MAIL_FROM_EMAIL=
#MAIL_FROM_NAME=Pytra

# Integrations (optional)
STEAM_API_KEY=
PSN_NPSSO=
#PSN_SCHEDULER_PAUSE=3s
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
#IGDB_PENDING_ENRICHMENT_ENABLED=true

# Access and limits (optional)
ALLOWED_EMAILS=
DEMO_USER_ID=
EXCLUSIVE_AVATAR_OWNERS=
#APP_TIME_ZONE=Europe/Madrid
#PLATFORMS_MAX_TOTAL=200
#PLATFORMS_CREATE_MAX_PER_WINDOW=20
#PLATFORMS_CREATE_WINDOW=1h
